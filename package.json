{
  "name": "cleanproof",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:pglite": "CLEANPROOF_DEV_PGLITE=true USE_PGLITE=true tsx scripts/dev-pglite-migrate.ts && CLEANPROOF_DEV_PGLITE=true USE_PGLITE=true next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run",
    "test:postgres": "USE_PGLITE=false vitest run tests/flows.postgres.integration.test.ts",
    "db:check": "tsx --env-file=.env.local scripts/check-postgres.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:dev": "tsx --env-file=.env.local scripts/migrate-dev.ts",
    "db:studio": "drizzle-kit studio",
    "seed": "tsx --env-file=.env.local scripts/seed.ts",
    "seed:pglite": "tsx scripts/seed-pglite.ts",
    "verify:pglite-demo": "tsx scripts/verify-pglite-demo.ts",
    "verify:marketing-assets": "node scripts/verify-marketing-assets.mjs",
    "billing:process": "tsx scripts/process-billing-dev.ts",
    "dev:e2e": "CLEANPROOF_DEV_PGLITE=true USE_PGLITE=true PGLITE_DATA_DIR=.data/pglite-e2e ALLOW_DEMO_MODE=true DISABLE_AUTH_RATE_LIMIT=true APP_URL=http://127.0.0.1:3099 AUTH_SECRET=e2e-auth-secret-minimum-32-characters!! CLEANPROOF_E2E_DIST=.next-e2e next dev -p 3099",
    "test:e2e": "playwright test",
    "test:e2e:ci": "node scripts/check-port-free.mjs 3099 && CI=1 playwright test --retries=0",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "drizzle-orm": "^0.44.5",
    "jose": "^6.1.0",
    "lucide-react": "^0.544.0",
    "next": "16.4.5",
    "nodemailer": "^10.3.1",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.3.1",
    "ulid": "^2.4.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@playwright/test": "^1.51.1",
    "@tailwindcss/turbopack": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "tsx": "^4.20.5",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
