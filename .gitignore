# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/
/e2e/visual/

# local side-by-side visual QA captures (see DESIGN_IMPLEMENTATION_PROGRESS.md)
.visual-review/

# next.js
/.next/
/.next-e2e/
/out/

# production
/build

# local dev store
.data/

# local design reference unpack (do not commit)
.design-ref/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
